# ---- 快速开始 ----
# 普通部署无需本地构建：镜像已由 GitHub Actions 自动发布到 ghcr.io
# （多架构 linux/amd64 + linux/arm64，AI/system 自动匹配）。
# 方式一（docker run 一行命令）：见 README「部署」；
# 方式二（compose）：cp .env.example .env → 按需填下方 IPB_MEMBER_ID / IPB_PASS_HASH
# 后 `docker compose up -d` 即可。**不复制 .env 也能直接启动**（全默认：公开内容、
# 镜像内置限流预设），本文件只是配置模板，仅供需要自定义时参照。
#
# **compose 会把本文件全部变量经 env_file 批量透传进容器**（.env 存在时；
# 缺失/为空则跳过，不影响启动）——无需在 docker-compose.yml 逐项映射；容器内 CACHE_DIR / ARCHIVE_DIR 固定指向持久卷（compose 内硬编码），
# 限流预设（HTML_INTERVAL_SECONDS / MAX_CONCURRENCY / IMAGE_MAX_CONCURRENCY /
# THUMB_MAX_CONCURRENCY）：推荐值为**保守值**（多客户端/服务器安全，compose 与镜像内置一致），
# 单用户自用部署可安全尝试更激进的 app 默认（HTML_INTERVAL_SECONDS=0.3、MAX_CONCURRENCY=5），
# 在本文件填写即覆盖（env_file 优先于镜像 ENV）。
# 自定义 env 路径（两个参数须指向同一文件，保证 environment 插值与 env_file 同源）：
#   PANDAPDS_ENV_FILE=/path/mine.env docker compose --env-file=/path/mine.env up -d
#
# 所有变量均可选：IPB 不填则服务仅提供公开内容（Latest/Popular/Toplist/Search），
# Watched/Favorites 导航、归档、收藏写操作/同步不可用；默认值即可运行。

# ---- E-Hentai identity (optional; fills the login state) ----
# Get these from your browser's cookies after logging into e-hentai.org.
# IPB_MEMBER_ID=
# IPB_PASS_HASH=
# IGNEOUS=            # 可选种子；exhentai 会在会话建立时自动下发 igneous，无需用户提供
# EH_SITE=e-hentai    # e-hentai | exhentai（缺省同上）

# ---- HTTP Basic Auth (optional) ----
# 两者都设置才启用：未配置时服务公开可访问。凭据为 base64 明文，
# 仅建议在 HTTPS 反代后启用。密码比较为常量时间（hmac.compare_digest）。
# AUTH_USERNAME=reader
# AUTH_PASSWORD=
# AUTH_EXEMPT_PATHS=   # 逗号分隔的精确路径，认证下仍公开（/health 恒豁免）

# ---- optional ----
# PUBLIC_BASE_URL=https://opds.example.com   # absolute URLs in feeds
# CACHE_DIR=./cache
# CACHE_MAX_GB=4
# IMAGE_CACHE_ENABLED=true
# HTML_INTERVAL_SECONDS=1.5
# MAX_CONCURRENCY=2            # HTML/API 出站并发上限（防封关键路径）
# IMAGE_MAX_CONCURRENCY=5      # 全图（/stream 原图）并发上限：509 配额流量，保守
# THUMB_MAX_CONCURRENCY=25     # 封面图/缩略图（ehgt CDN）并发上限：对齐浏览器 25 缩略图并发
# TIMEOUT_SECONDS=6
# RETRIES=3
# BANNED_COOLDOWN_SECONDS=1800  # IP 封禁熔断冷却（秒）；封禁以小时计，长冷却减少无效试探
# EXCEED_COOLDOWN_SECONDS=300   # 图片限额熔断冷却（秒）；配额分钟级滚动，短冷却快速恢复
# METADATA_TTL_SECONDS=600    # gdata 结果缓存；主链路零 gdata（详情走详情页 HTML），保留作兜底
# TAG_STATUS_FILTER=balanced  # 标签可信度过滤：balanced(默认)=confidence+skepticism，strict=仅 confidence，off=全部
# COMMENTS_ENABLED=true       # 详情文档（OPDS 2.0）输出评论区 extensions.reviews（解析始终进行，仅控制输出）
# EH_PROFILE=PandaOPDS        # uconfig 独立 profile 名；设空串则关闭 profile
# PSE_PAGE_BASE=1             # PSE 页码基数（1-based，OPDS-PSE 规范原文为 0-based）
# OPDS_ACQ_DETAIL=false        # 布尔：false(默认)=acquisition 直接指向图片流（零二次请求）；true=指向详情文档（二次请求流程）。旧 OPDS_ACQ_MODE=detail|direct 仍兼容
# FACETS=Doujinshi:1021,Manga:1019,...   # 分类筛选掩码（Name:mask 逗号分隔）；默认 10 个 EH 分类；v2.0 gallery 的 category 参数与 Category facets 据此生成
# LOG_LEVEL=INFO              # INFO | DEBUG（DEBUG 输出每次出站请求，用于排障）

# ---- Archive（E-Hentai archiver，消耗 GP，需登录 + 星会员）----
# 购买归档后统一保存为 zip（cbz）母本于 ARCHIVE_DIR/{gid}/{token}/，可为同 gid/token
# 的 /stream 提供长效缓存（不受磁盘缓存 LRU / 7 天 TTL 约束，独立持久卷）。
# 启用条件：IPB_MEMBER_ID + IPB_PASS_HASH 均已配置（派生，无独立开关）。
# 只有通过 WebUI/API 显式触发（quote 报价 → 确认 → start），绝无自动触发。
# ARCHIVE_DIR=./archives              # 持久目录（docker 建议独立卷）
# ARCHIVE_QUALITY=original           # 默认画质档（start 未传 quality 时；original 映射 org 无损档）
# ARCHIVE_DOWNLOAD_CONCURRENCY=5     # 下载/7z 转换并发上限，其余排队（归档流量不受阅读限流，仍过熔断）

# ---- Favorites（收藏夹操作代理 + 同步）----
# 写操作代理：POST /api/favorites（action=add|move|remove + gid/token + favcat），
# 经由 gallerypopups.php 转发 EH；需 IPB_MEMBER_ID + IPB_PASS_HASH（无登录态 403）。
# 同步：周期增量扫描收藏夹，可选对新增项自动归档（消耗 GP，默认关闭）。
# FAVORITES_SYNC_INTERVAL_SECONDS=3600 # 同步周期（秒）；默认 1 小时（增量扫描每次仅 1-3 页，负载可忽略）；0 = 关闭周期扫描（写操作后的防抖触发同步与手动 POST /api/favorites/sync/run 仍生效）
# FAVORITES_SYNC_ARCHIVE=0           # 1 = 对扫描到的新增收藏项自动执行 Archive（消耗 GP！需手动开启；首次运行仅建档不归档，自第二次起生效）
# FAVORITES_SYNC_CATEGORIES=         # 作用域：逗号分隔的 favcat ID；留空 = 全扫；-ID = 排除该分区（如 -0 = 除 0 分区外全扫；-0,-5 = 排除 0 和 5）。生效 scope = (白名单或全部) − 排除项
# FAVORITES_SYNC_STATE=  # 同步快照（已扫描/已归档 gid；删除可重置基线）。缺省：容器内 /config/favorites_sync.json（持久），本地 ./favorites_sync.json
# FAVORITES_SYNC_MATCH_THRESHOLD=5   # 连续 N 个已知 gid 即停止增量翻页
# FAVORITES_SYNC_MAX_PAGES=50        # 单轮扫描页数硬上限

# ---- Tag Translation（中文标签翻译，EhTagTranslation 词典，可选）----
# 开启后 OPDS 2.0 subject 输出中文命名空间:译名（如 女性:巨乳，emoji 已剥离），
# 搜索支持中文标签词反查为 EH 原生关键词（女性:巨乳 / female:巨乳 / f:巨乳 等
# 前缀形态精确转义；裸词仅唯一命中才转义）。关闭时零行为变化、零出站请求。
# TAG_TRANSLATION_ENABLED=0            # 1 = 启用
# TAG_TRANSLATION_URL=                 # 默认 GitHub release latest 的 db.text.json；可指向自镜像
# TAG_TRANSLATION_INTERVAL_SECONDS=86400  # 后台刷新间隔（秒）；0 = 仅启动时拉取一次
# TAG_TRANSLATION_STATE=  # 磁盘快照；删除后下次刷新重新下载。缺省：容器内 /config/tag_translation.json（持久），本地 ./tag_translation.json
