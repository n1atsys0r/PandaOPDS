# PandaOPDS OPDS 2.0 编排布局
#
# 支持多页面结构（[[page]]）与旧版单页结构（直接声明 [[section]]）。
#
# 每个 [[page]] 声明一个页面：
#   id           = 页面唯一标识（主页必须为 "home"，自定义页面使用字母数字中划线下划线）
#   title        = 页面标题
#   mode         = "sections" (分组栏目模式) 或 "publications" (出版物流模式)
#
# 每个 [[page.section]]（或根级 [[section]]）声明一个栏目：
#   kind         = "publication" | "navigation" | "facets"
#   group        = true 时，publication 形成独立画廊分组，navigation 形成独立导航分组；缺省为 false
#   title        = 栏目或分组标题
#   type / query = "preset" + 内置预设，或 "search" + 搜索表达式，或 "page" + 目标页面 id
#   count        = publication 的预览条数，缺省为 10，填 0 关闭预览
#   items        = navigation 分组包含的子导航项列表，各子项拥有独立的 title、type 和 query
#
# 顶层 publications 与 groups 互斥；顶层 navigation 可与其中任一形式并存。
# 内置预设：latest、popular、watched、favorites、favorites:N、archives、history、
# toplist:yesterday、toplist:month、toplist:year、toplist:alltime。

# ================= 主页 (Home) =================
[[page]]
id = "home"
title = "Home"
mode = "groups"

# ---- 默认顶级 Navigation ----
[[page.section]]
kind = "navigation"
group = false
type = "page"
query = "home"

[[page.section]]
kind = "navigation"
group = false
title = "Watched"
type = "page"
query = "watched"

[[page.section]]
kind = "navigation"
group = false
title = "Favorites"
type = "page"
query = "favorites"

[[page.section]]
kind = "navigation"
group = false
type = "page"
query = "toplists"

[[page.section]]
kind = "navigation"
group = false
title = "Archives"
type = "page"
query = "archives"

# ---- 浏览组 (Popular > Latest > Recently Read) ----
[[page.section]]
kind = "publication"
group = true
title = "Popular"
type = "preset"
query = "popular"
count = 20

[[page.section]]
kind = "publication"
group = true
title = "Latest"
type = "preset"
query = "latest"
count = 20

[[page.section]]
kind = "publication"
group = true
title = "Recently Read"
type = "preset"
query = "history"
count = 20

# ================= 页面: Watched =================
[[page]]
id = "watched"
title = "Watched"
mode = "publications"

[[page.section]]
kind = "navigation"
group = false
title = "Watched"
type = "page"
query = "watched"

[[page.section]]
kind = "navigation"
group = false
title = "Favorites"
type = "page"
query = "favorites"

[[page.section]]
kind = "navigation"
group = false
title = "Toplists"
type = "page"
query = "toplists"

[[page.section]]
kind = "navigation"
group = false
title = "Archives"
type = "page"
query = "archives"

[[page.section]]
kind = "publication"
group = false
title = "Watched"
type = "preset"
query = "watched"
count = 20

[[page.section]]
kind = "facets"
group = false
title = "Filter"
type = "preset"
query = "watched"

