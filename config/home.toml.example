# PandaOPDS 首页布局
# ====================
#
# [[group]]         声明命名组（决定 groups[] 顺序和标题）
#   id              = 唯一标识符
#   title           = 组的 metadata.title
#
# [[section]]       挂载到组或独立出现
#   group           = 引用 [[group]] 的 id；不设 → 独立
#   kind            = "publication"（含内嵌预览）| "navigation"（纯链接）
#   type / query    = "preset" + 内置 key 或 "search" + 搜索表达式
#   preset key      = latest / popular / watched / favorites / favorites:N / archives /
#                     toplist:yesterday / toplist:month / toplist:year / toplist:alltime
#                     （favorites:N 按收藏目录收敛，对应上游 /favorites.php?favcat=N；
#                      仅 v2.0，需手写 section，不进入默认模板）
#   count           = publication 时生效，内嵌预览条数；缺省 = 10，显式 0 = 禁用
#
# 规则：
#   - 同一 group 的 section 合并进一个 groups[] 槽位（publication + navigation 可混）
#   - 无 group 的 publication → 独立 groups[] 槽位
#   - 无 group 的 navigation  → 根 navigation[]

[[group]]
id = "rankings"
title = "Rankings"

[[group]]
id = "browse"
title = "Browse"

# ---- 排行榜组 ----

[[section]]
group = "rankings"
kind = "publication"
title = "Toplist: Yesterday"
type = "preset"
query = "toplist:yesterday"
count = 5

[[section]]
group = "rankings"
kind = "navigation"
title = "Toplist: Month"
type = "preset"
query = "toplist:month"

[[section]]
group = "rankings"
kind = "navigation"
title = "Toplist: Year"
type = "preset"
query = "toplist:year"

# ---- 浏览组 ----

[[section]]
group = "browse"
kind = "publication"
title = "Popular"
type = "preset"
query = "popular"
count = 10

[[section]]
group = "browse"
kind = "navigation"
title = "Latest"
type = "preset"
query = "latest"

# ---- 独立 publication ----

[[section]]
kind = "publication"
title = "Chinese Doujinshi"
type = "search"
query = "language:chinese"
count = 15

# ---- 根 navigation ----

[[section]]
kind = "navigation"
title = "Toplist: All Time"
type = "preset"
query = "toplist:alltime"

[[section]]
kind = "navigation"
title = "Watched"
type = "preset"
query = "watched"

[[section]]
kind = "navigation"
title = "Favorites"
type = "preset"
query = "favorites"

[[section]]
kind = "navigation"
title = "Japanese Original"
type = "search"
query = "language:japanese"

[[section]]
kind = "navigation"
title = "Archives"
type = "preset"
query = "archives"
