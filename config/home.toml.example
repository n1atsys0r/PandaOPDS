# PandaOPDS OPDS 2.0 首页布局
#
# 每个 [[section]] 声明一个栏目。
#   kind         = "publication" | "navigation" | "facets"
#   group        = true 时，publication 或 navigation 形成独立分组；缺省为 false
#   title        = 栏目标题
#   type / query = "preset" + 内置预设，或 "search" + 搜索表达式
#   count        = publication 的预览条数，缺省为 10，填 0 关闭预览
#
# 顶层 publications 与 groups 互斥；顶层 navigation 可与其中任一形式并存。
# facets 只能与顶层 publication 并用，type 和 query 须与其相同。
# 内置预设：latest、popular、watched、favorites、favorites:N、archives、
# toplist:yesterday、toplist:month、toplist:year、toplist:alltime。

# ---- 排行榜 ----

[[section]]
kind = "publication"
group = true
title = "Toplist: Yesterday"
type = "preset"
query = "toplist:yesterday"
count = 5

[[section]]
kind = "navigation"
group = true
title = "Toplist: Month"
type = "preset"
query = "toplist:month"

[[section]]
kind = "navigation"
group = true
title = "Toplist: Year"
type = "preset"
query = "toplist:year"

# ---- 浏览组 ----

[[section]]
kind = "publication"
group = true
title = "Popular"
type = "preset"
query = "popular"
count = 10

[[section]]
kind = "navigation"
group = true
title = "Latest"
type = "preset"
query = "latest"

# 本示例使用 groups，因此不配置顶层 publication / facets。
# 另一种布局可将 publication 和 facets 设为 group=false，并移除所有 group=true 栏目。

# ---- 根 navigation ----

[[section]]
kind = "navigation"
group = false
title = "Toplist: All Time"
type = "preset"
query = "toplist:alltime"

[[section]]
kind = "navigation"
group = false
title = "Watched"
type = "preset"
query = "watched"

[[section]]
kind = "navigation"
group = false
title = "Favorites"
type = "preset"
query = "favorites"

[[section]]
kind = "navigation"
group = false
title = "Japanese Original"
type = "search"
query = "language:japanese"

[[section]]
kind = "navigation"
group = false
title = "Archives"
type = "preset"
query = "archives"
